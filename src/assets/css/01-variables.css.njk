/* assets/css/01-variables.css
 *
 * Overrides chota's CSS custom properties rather than writing new
 * selectors. "Work with chota, not against it." Full list of chota's
 * variables: https://jenil.github.io/chota/#colors
 *
 * This file is a Nunjucks template that pulls all design tokens from
 * src/_data/site.js (fonts and theme sections). To customize your site's
 * appearance, edit site.js instead of this file. The CSS will automatically
 * pick up your changes on the next build.
 */

/* chota sets the <html> root font-size to 62.5% (so 1rem = 10px) and then
 * scales `body` back up with `--font-size: 1.6rem` (10px * 1.6 = 16px).
 * That's fine for chota's own components, which are all sized in rem to
 * match. But it means any *other* rem value in this file (or yours) is
 * secretly 62.5% of what it looks like. Resetting the root to 100% (so
 * 1rem = 16px, the normal browser default) makes every size in this
 * starter's CSS mean what it says. */
html {
  font-size: 100%;
  box-sizing: border-box;
}

*, *::before, *::after {
  box-sizing: inherit;
}

body {
  max-width: 100vw;
  overflow-x: hidden;
}

/* Global image rules - ensure all images honor viewport */
img {
  max-width: 100%;
  height: auto;
  display: block;
}

:root {
  --font-family-serif: {{ site.fonts.body | safe }};
  --font-family-sans: {{ site.fonts.heading | safe }};
  --font-family-mono: {{ site.fonts.monospace | safe }};
  --font-size: 1rem;

  --bg-color: {{ site.theme.light.bg }};
  --bg-secondary-color: {{ site.theme.light.bgSecondary }};
  --font-color: {{ site.theme.light.font }};

  /* The one accent color in this file. */
  --color-primary: {{ site.theme.light.primary }};

  --color-lightGrey: {{ site.theme.light.lightGrey }};
  --color-grey: {{ site.theme.light.grey }};
  --color-darkGrey: {{ site.theme.light.darkGrey }};
  --color-error: {{ site.theme.light.error }};
  --color-success: {{ site.theme.light.success }};

  /* Not chota variables. chota doesn't expose separate visited/hover
     link colors of its own, so these are used directly in the split CSS files.
     `--color-lightGrey` doubles as the border color throughout. */
  --link-color: var(--color-primary);
  --link-visited-color: {{ site.theme.light.linkVisited }};
  --link-hover-color: {{ site.theme.light.linkHover }};
}

h1,
h2,
h3,
h4,
h5,
h6 {
  font-family: var(--font-family-sans);
}

a {
  color: var(--link-color);
}

a:visited {
  color: var(--link-visited-color);
}

a:hover {
  color: var(--link-hover-color);
}

/* chota ships light/dark support via [data-theme="dark"] on <html>, but a
   zero-JS CSS-only prefers-color-scheme toggle costs nothing and fits the
   "as little JS as possible" ethos. See README.md for how to
   layer a manual localStorage-backed toggle on top if you want one. */
@media (prefers-color-scheme: dark) {
  :root {
    --bg-color: {{ site.theme.dark.bg }};
    --bg-secondary-color: {{ site.theme.dark.bgSecondary }};
    --font-color: {{ site.theme.dark.font }};

    --color-primary: {{ site.theme.dark.primary }};

    --color-lightGrey: {{ site.theme.dark.lightGrey }};
    --color-grey: {{ site.theme.dark.grey }};
    --color-darkGrey: {{ site.theme.dark.darkGrey }};
    --color-error: {{ site.theme.dark.error }};
    --color-success: {{ site.theme.dark.success }};

    --link-color: var(--color-primary);
    --link-visited-color: {{ site.theme.dark.linkVisited }};
    --link-hover-color: {{ site.theme.dark.linkHover }};
  }
}