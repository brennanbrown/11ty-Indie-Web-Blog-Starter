---
layout: base.njk
---
<article class="h-entry">
  {% if featured_image %}
    <figure class="featured-image">
      <img src="{{ featured_image }}" alt="{{ featured_image_alt }}" loading="lazy">
      {% if featured_image_caption %}
        <figcaption>{{ featured_image_caption | markdown | safe }}</figcaption>
      {% endif %}
    </figure>
  {% endif %}
  <header class="post-header">
    <h1 class="p-name post-title">{{ title }}</h1>
    <div class="post-meta">
      <time class="dt-published" datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>
      {% if postType %}
        <span class="separator">·</span>
        <span class="post-type">{{ postType | capitalize }} by {{ site.author.name }}</span>
      {% endif %}
      <span class="separator">·</span>
      <span class="post-stats">{{ content | readingTime }}</span>
      <span class="separator">·</span>
      <span class="post-stats">{{ content | wordCount }} words</span>
    </div>
  </header>
  <div class="e-content">
    {{ content | safe }}
  </div>
  <footer class="post-footer">
    {% if tags %}
      <div class="post-tags">
        {% set taglist = tags | filterTagList %}
        {% for tag in taglist %}
          <a class="p-category tag" href="/tags/#{{ tag | slugify }}">#{{ tag }}</a>
        {% endfor %}
      </div>
    {% endif %}
  </footer>
</article>

{% if site.webmention.enabled %}
  {% include "partials/webmentions.njk" %}
{% endif %}