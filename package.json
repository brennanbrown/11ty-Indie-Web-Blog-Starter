{
  "name": "indieweb-11ty-starter",
  "version": "1.0.0",
  "description": "A minimal-but-opinionated Eleventy starter for getting into the IndieWeb",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "Brennan Kenneth Brown",
  "keywords": [
    "eleventy",
    "indieweb",
    "starter",
    "blog",
    "jamstack"
  ],
  "scripts": {
    "start": "eleventy --serve",
    "build": "eleventy && npx pagefind --site _site",
    "debug": "DEBUG=Eleventy* eleventy",
    "clean": "rimraf _site .cache"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "pagefind": "^1.5.2",
    "rimraf": "^6.1.3"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "@11ty/eleventy-fetch": "^5.1.3",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@11ty/eleventy-img": "^7.0.0",
    "@11ty/font-awesome": "^1.0.1",
    "@11ty/eleventy-plugin-rss": "^3.0.0",
    "chota": "^0.9.2",
    "luxon": "^3.7.2",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-footnote": "^4.0.0"
  }
}
